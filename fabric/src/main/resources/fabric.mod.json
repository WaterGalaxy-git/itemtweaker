{
  "schemaVersion": 1,
  "id": "itemtweaker",
  "version": "${version}",
  "name": "ItemTweaker",
  "description": "Configure any vanilla or modded item's data components, including durability, stack size, attributes, food, and more, from a single JSON file. Works globally across all worlds, no datapacks required.",
  "authors": ["WaterGalaxy"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/itemtweaker",
    "sources": "https://github.com/WaterGalaxy-git/itemtweaker",
    "issues": "https://github.com/WaterGalaxy-git/itemtweaker/issues"
  },
  "license": "MIT",
  "icon": "assets/itemtweaker/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.watergalaxy.itemtweaker.fabric.ItemTweakerFabric"
    ]
  },
  "mixins": ["itemtweaker.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1 <26.4-"
  }
}
